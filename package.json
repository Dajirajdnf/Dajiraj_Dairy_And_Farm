{
  "name": "dajiraj-dairy-and-farm",
  "version": "1.0.0",
  "description": "Dajiraj Dairy & Farm - Full-Stack Dairy Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "postinstall": "cd client && npm install --include=dev",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "seed:admin": "node server/seedAdmin.js",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "puppeteer": "^22.8.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
