# ============================================
# Dajiraj Dairy & Farm — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# For local development:
# MONGODB_URI=mongodb://localhost:27017/dajiraj_dairy
#
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dajiraj_dairy?retryWrites=true&w=majority
#
# Or use separate username/password (they replace <username> and <password> in the URI):
# MONGODB_USERNAME=your_atlas_username
# MONGODB_PASSWORD=your_atlas_password
MONGODB_URI=mongodb://localhost:27017/dajiraj_dairy
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ---- JWT ----
# IMPORTANT: Generate a strong secret for production!
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_EXPIRE=7d

# ---- SMTP Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Dajiraj Dairy & Farm
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# ---- URLs ----
# For local development:
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
#
# For Vercel production:
# CLIENT_URL=https://your-domain.vercel.app
# SERVER_URL=https://your-domain.vercel.app

# ---- Vercel Cron (optional) ----
# Secret key to authorize cron API calls
CRON_SECRET=

# ---- Frontend (VITE_ prefix = exposed to browser, only put safe values here) ----
VITE_API_URL=/api
